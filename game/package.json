{
  "name": "starpath-football",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:start": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --publish never",
    "desktop:build:win": "npm run build && electron-builder --win --publish never -c.electronDist=node_modules/electron/dist",
    "desktop:build:mac": "npm run build && electron-builder --mac --publish never",
    "desktop:build:linux": "npm run build && electron-builder --linux --publish never",
    "cap:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "android:apk": "npm run cap:sync && node scripts/android-gradle.mjs assembleDebug",
    "android:bundle": "npm run cap:sync && node scripts/android-gradle.mjs bundleRelease",
    "icons:native": "node scripts/gen-native-res.mjs",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@preact/signals": "^2.11.3",
    "phaser": "^4.2.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "description": "StarPath Football — futbol kariyeri ve yaşam simülasyonu",
  "author": "StarPath Football",
  "main": "electron/main.cjs"
}
