# /etc/caddy/Caddyfile — TLS (automatic, Let's Encrypt) in front of the shop server on 127.0.0.1:8787.
206-189-63-64.sslip.io {
	# No product banner.
	header -Server

	# App Store Server Notifications nest signed JWS inside a signed JWS (three certificate chains),
	# so this one path takes larger bodies. The server enforces the same limits (http.mjs).
	handle /v1/apple/notifications {
		request_body {
			max_size 128KB
		}
		reverse_proxy 127.0.0.1:8787 {
			# Overwrite (never append to) a client-sent X-Forwarded-For: the server rate-limits by it.
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	log {
		output file /var/log/caddy/starpath.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
