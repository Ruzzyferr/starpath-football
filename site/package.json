{
  "name": "kickborn-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "render": "node scripts/render.mjs",
    "dev": "node scripts/render.mjs && vite",
    "build": "node scripts/render.mjs && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "build:play": "node scripts/build-play.mjs",
    "build:all": "npm run build && npm run build:play",
    "preview": "vite preview --port 5794",
    "test": "node --test test/penalty.test.ts",
    "test:viewports": "node test/viewports.mjs http://localhost:5794/ viewport-shots"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "three": "^0.186.1"
  }
}