# /etc/caddy/Caddyfile — TLS (automatic, Let's Encrypt) in front of the shop server on 127.0.0.1:8787,
# and the static site (site/dist, see site/README.md) from /srv/starpath-site.
kickborn.swiip.app, starpath.swiip.app, 206-189-63-64.sslip.io {
	# No product banner.
	header -Server

	# App Store Server Notifications nest signed JWS inside a signed JWS (three certificate chains),
	# so this one path takes larger bodies. The server enforces the same limits (http.mjs).
	handle /v1/apple/notifications {
		request_body {
			max_size 128KB
		}
		reverse_proxy 127.0.0.1:8787 {
			# Overwrite (never append to) a client-sent X-Forwarded-For: the server rate-limits by it.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Public pages the store listings link to: privacy policy, terms, support (static, read-only).
	# Files: server/site/ plus game/public/legal/, copied to /srv/starpath-site on deploy.
	handle /legal/* {
		root * /srv/starpath-site
		file_server
	}
	handle /support* {
		root * /srv/starpath-site
		try_files {path} {path}.html
		file_server
	}
	handle /app-ads.txt {
		root * /srv/starpath-site
		file_server
	}

	# The shop API: every server route lives under /v1 (server/src/http.mjs).
	handle /v1/* {
		request_body {
			max_size 32KB
		}
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# The marketing site (site/dist) and the browser build of the game under /play/, same root as
	# the legal pages. Clean URLs: /en -> /en/index.html, /support -> support.html.
	handle {
		root * /srv/starpath-site
		header X-Content-Type-Options nosniff
		header Referrer-Policy strict-origin-when-cross-origin

		# Content-hashed build files never change: cache for a year.
		@hashed path /assets/* /play/assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Pictures and clips: a week (replace by renaming the file).
		@media path /media/* /play/icons/* /fonts/*
		header @media Cache-Control "public, max-age=604800"
		# Pages, the game's service worker and its manifest: always revalidate.
		header ?Cache-Control "no-cache"

		try_files {path} {path}/index.html {path}.html
		file_server
	}

	# Unknown addresses get the site's own 404 page (site/public/404.html), still with status 404.
	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			root * /srv/starpath-site
			rewrite * /404.html
			file_server
		}
	}

	# Access log: client addresses masked (IPv4 /16, IPv6 /32), query strings dropped (the Play
	# RTDN push carries ?token=), secret headers removed; files rolled and kept 30 days at most.
	log {
		output file /var/log/caddy/starpath.log {
			roll_size 10MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>client_ip ip_mask {
					ipv4 16
					ipv6 32
				}
				request>uri regexp "[?].*$" ""
				request>headers>Authorization delete
				request>headers>X-Rtdn-Token delete
				request>headers>X-Ops-Token delete
				request>headers>X-Forwarded-For delete
			}
		}
	}
}
