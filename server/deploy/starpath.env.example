# /etc/starpath.env (root:starpath, mode 0640). No secrets in this example: fill them on the box.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=/opt/starpath/data
# Caddy overwrites X-Forwarded-For with the client address (see Caddyfile).
TRUST_PROXY=1
ORIGINS=capacitor://localhost,https://localhost,http://localhost

APPLE_BUNDLE_ID=app.starpath.football

# Store test purchases (TestFlight / Play licence testers):
#   off     refuse them (production default)
#   testers only for the account ids in SANDBOX_TESTERS (comma-separated)
#   capped  everyone, recorded as env Sandbox, at most SANDBOX_CAP diamonds per account, lifetime
#   on      development servers only (refused with NODE_ENV=production)
SANDBOX_POLICY=capped
SANDBOX_TESTERS=
SANDBOX_CAP=3000

# Rewarded ads: 1 once the AdMob SSV callback (https://<host>/v1/admob/ssv) is configured.
REQUIRE_SSV=0

# Google Play (Android purchases are refused until both are set):
# service-account JSON readable by the starpath user, e.g. /opt/starpath/data/play-sa.json
GOOGLE_SA_FILE=
ANDROID_PACKAGE=
# Pub/Sub push subscription URL: https://<host>/v1/google/rtdn?token=<RTDN_TOKEN>  (openssl rand -hex 24)
RTDN_TOKEN=

# Optional rate-limit overrides.
# REG_PER_MIN=30
# IP_PER_MIN=600
